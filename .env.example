# Native Windows conda shortcutminer. Copy to ignored .env.formal for local use.
# API CLI commands load .env.formal into the process only; acceptance never loads it.
# Never put credential values in source, configs, logs, reports, or CLI arguments.
# Public empty placeholders only.
SHORTCUTMINER_OPENAI_API_KEY=
SHORTCUTMINER_DEEPSEEK_API_KEY=
SHORTCUTMINER_LOCAL_API_KEY=
SHORTCUTMINER_VLM_API_KEY=
SHORTCUTMINER_TEXT_API_KEY=
SHORTCUTMINER_REAL_SAM_TEST=
SHORTCUTMINER_SAM_CHECKPOINT=
