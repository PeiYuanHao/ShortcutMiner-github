# Docker defaults to an offline mock. Set bridge only for explicit API runs.
SHORTCUTMINER_NETWORK_MODE=none

# Name credentials by model configuration; never commit their values.
# Compose does not pass credentials automatically; use run -e NAME explicitly.
SHORTCUTMINER_OPENAI_API_KEY=
SHORTCUTMINER_DEEPSEEK_API_KEY=
SHORTCUTMINER_LOCAL_API_KEY=
SHORTCUTMINER_VLM_API_KEY=
