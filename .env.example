# docker-compose.yml remains offline by default.
# Real API runs explicitly add docker-compose.api.yml, which loads credentials
# from the local Git-ignored .env.phase16 file and enables bridge networking.
# Never commit .env.phase16 or pass API keys through command history when avoidable.
SHORTCUTMINER_NETWORK_MODE=none

# Public placeholders only. Real values belong in .env.phase16.
SHORTCUTMINER_OPENAI_API_KEY=
SHORTCUTMINER_DEEPSEEK_API_KEY=
SHORTCUTMINER_LOCAL_API_KEY=
SHORTCUTMINER_VLM_API_KEY=
SHORTCUTMINER_TEXT_API_KEY=
SHORTCUTMINER_REAL_SAM_TEST=
SHORTCUTMINER_SAM_CHECKPOINT=
