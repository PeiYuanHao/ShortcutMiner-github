      "post_invocation_classification": "STORAGE_RUNTIME_FAILURE"
    },
    {
      "component": "artifact path authorization",
      "post_invocation": "path escape or forbidden artifact rejection",
      "post_invocation_classification": "SECURITY_FAILURE"
