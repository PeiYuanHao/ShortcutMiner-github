{
  "text_model_config": "configs/models/pilot_text.example.yaml",
  "vlm_model_config": "configs/models/pilot_vlm.example.yaml",
  "promotion_policy": {
    "policy_version": "budgeted-paired-probe-v2",
    "calibration_status": "externally_frozen",
    "strategy": "budgeted_paired_probe",
    "max_probe_candidates": 3,
    "metric_rules": []
  },
  "execution_options": {
    "model_backend": "torchvision_resnet_matrix",
    "feature_version": "torchvision_rgb224_v1",
    "training_options": {
      "architectures": [
        "resnet18",
        "resnet50"
      ],
      "seeds": [
        42,
        43,
        44
      ],
      "epochs": 100,
      "minimum_epochs": 10,
      "early_stopping_patience": 10,
      "batch_size": 32,
      "learning_rate": 0.001,
      "momentum": 0.9,
      "weight_decay": 0.0001,
      "workers": 4,
      "torch_threads": 24,
      "amp": true,
      "checkpoint_interval": 5,
      "augmentation": "spatial_preserving"
    },
    "adaptive_screening": {
      "minimum_effect": 0.02,
      "family_alpha": 0.05,
      "candidate_budget": 3,
      "pair_checkpoints": [
        128,
        256,
        512,
        1024,
        1500
      ],
      "probe_fraction": 0.75,
      "sensitivity_effects": [
        0.01,
        0.02,
        0.05
      ],
      "confidence_method": "paired-betting-cs-v1"
    }
  }
}
