# Python cache
__pycache__/
*.py[cod]

# Pytest
.pytest_cache/

# Virtual environments and packaging output
.venv/
venv/
env/
build/
dist/
*.egg-info/

# IDE and OS temporary files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local credentials and environment overrides
.env
.env.*
!.env.example

# Raw datasets (keep preparation documentation)
data/*
!data/README.md
datasets/

# Raw experiment runs (keep the directory scaffold)
runs/*
!runs/.gitkeep

# Generated artifacts, checkpoints, results, and local container data
artifacts/
checkpoints/
results/
.docker-data/
docker-data/

# Logs and temporary files
*.log
*.tmp
*.temp
